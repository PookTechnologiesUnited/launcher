<Application
	x:Class="Wauncher.App"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Wauncher"
	x:CompileBindings="True"
	x:DataType="local:App"
	RequestedThemeVariant="Default">
	<!--  "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options.  -->

	<Application.DataTemplates>
		<local:ViewLocator />
	</Application.DataTemplates>

	<Application.Styles>
		<FluentTheme />
		<StyleInclude Source="/Assets/Styles.axaml" />
		<Style Selector="Window">
			<Setter Property="CanResize" Value="False" />
		</Style>
	</Application.Styles>

	<TrayIcon.Icons>
		<TrayIcons>
			<TrayIcon
				Command="{Binding TrayIconClickedCommand}"
				Icon="/Assets/Wauncher.ico"
				ToolTipText="Wauncher">
				<TrayIcon.Menu>
					<NativeMenu>
						<NativeMenuItem Header="Discord RPC is running" IsEnabled="False" />
						<NativeMenuItemSeparator />
						<NativeMenuItem Click="ExitApplication_Click" Header="E_xit" />
					</NativeMenu>
				</TrayIcon.Menu>
			</TrayIcon>
		</TrayIcons>
	</TrayIcon.Icons>
</Application>
